# Valeurs sûres pour npm run dev. La surcouche Docker locale utilise le port 3010.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Garder à 1 en local. Utiliser uniquement des clés de test si ce verrou est levé.
DISABLE_EXTERNAL_SERVICES=1
# Activer uniquement derrière un proxy qui écrase les en-têtes d'adresse client.
TRUSTED_PROXY_HEADERS=0
# Auth.js et Mailpit local. Remplacer AUTH_SECRET par une valeur aléatoire hors développement.
AUTH_URL=http://localhost:3000
AUTH_SECRET=local-only-formeducweb-auth-secret
AUTH_EMAIL_PROVIDER=nodemailer
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=0
AUTH_SMTP_ALLOW_LOCAL=1
AUTH_SMTP_FROM=FormeducWeb <connexion@formeducweb.local>
LMS_BOOTSTRAP_ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CENTS=2900
STRIPE_CURRENCY=cad
REPORT_UNLOCK_PRICE_LABEL=29 $
DATABASE_URL=file:./prisma/dev.db
ASSESSMENT_RETENTION_UNPAID_DAYS=180
ASSESSMENT_RETENTION_REFUNDED_DAYS=730
ADMIN_NOTIFICATION_EMAIL=
ADMIN_EMAIL=info@formeducweb.ca
CONTACT_TO_EMAIL=info@formeducweb.ca
RESEND_API_KEY=
RESEND_FROM=FormEducWeb <noreply@example.com>
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_JOB_SECRET=
EMAIL_JOB_ENDPOINT=http://formeducweb:3000/api/internal/email-jobs
EMAIL_JOB_INTERVAL_MS=300000
