# Copier en .env.production sur le VPS (ne pas commiter .env.production)
# La base SQLite est forcée par docker-compose : file:/data/production.db

NEXT_PUBLIC_BASE_URL=https://formeducweb.ca
NEXT_PUBLIC_SITE_URL=https://formeducweb.ca
EMAIL_PUBLIC_BASE_URL=https://formeducweb.ca
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# La production peut appeler Stripe et Resend après ajout de vraies clés sur le VPS.
DISABLE_EXTERNAL_SERVICES=0
# Activer uniquement si le proxy frontal écrase X-Forwarded-For/X-Real-IP/CF-Connecting-IP.
TRUSTED_PROXY_HEADERS=0

# Auth.js : générer AUTH_SECRET avec une valeur aléatoire longue avant démarrage.
# Resend reste inactif tant que sa clé et son expéditeur ne sont pas fournis.
AUTH_URL=https://formeducweb.ca
AUTH_SECRET=
AUTH_EMAIL_PROVIDER=resend
LMS_BOOTSTRAP_ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CENTS=2900
STRIPE_CURRENCY=cad
REPORT_UNLOCK_PRICE_LABEL=29 $

RESEND_API_KEY=
RESEND_FROM=FormÉducWeb <noreply@formeducweb.ca>
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_JOB_SECRET=
EMAIL_JOB_INTERVAL_MS=300000

ADMIN_EMAIL=info@formeducweb.ca
CONTACT_TO_EMAIL=info@formeducweb.ca
ADMIN_NOTIFICATION_EMAIL=

ASSESSMENT_RETENTION_UNPAID_DAYS=180
ASSESSMENT_RETENTION_REFUNDED_DAYS=730
